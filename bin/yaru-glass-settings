        self.repair = Gtk.Button(label="Repair invalid preferences…", halign=Gtk.Align.START)
        self.repair.connect("clicked", self.confirm_repair)
        body.append(self.repair)
        body = self.page_bodies["applications"]
        app_group = Adw.PreferencesGroup(title="Settings app transparency",
                                        description="Only this window. Files and other apps stay unchanged. "
                                                    "Follows Frost/Crystal; controls stay solid. No blur.")
