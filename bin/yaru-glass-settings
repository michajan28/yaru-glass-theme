        body.append(boost_reset)
        heading = Gtk.Label(label="Glass appearance", xalign=0)
        heading.add_css_class("title-2")
        body.append(heading)
        body.append(Gtk.Label(
            label="Adjust the glass surfaces of the panel, menus, calendar, and dock. "
                  "Applies to both light and dark themes; app windows are unchanged.",
