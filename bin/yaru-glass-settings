        wallpaper_heading = Gtk.Label(label="Light and dark wallpapers", xalign=0)
        wallpaper_heading.add_css_class("title-3")
        body.append(wallpaper_heading)
        body.append(Gtk.Label(label="GNOME switches these automatically with Light/Dark Style. "
                                   "Images stay at their original location.", wrap=True, xalign=0))
