        options.add(self.blur_switch)
        self.boost_switch = Adw.SwitchRow(title="Readability boost",
                                          subtitle="Stronger tint on supported surfaces; never dims text")
        self.boost_switch.set_active(self.shell_settings["readability_boost"])
        options.add(self.boost_switch)
        body.append(options)
        boost_reset = Gtk.Button(label="Reset readability boost…", halign=Gtk.Align.START)
