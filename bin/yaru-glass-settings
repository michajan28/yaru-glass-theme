        body.append(self.files_opacity)
        presets = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=6,
                              row_spacing=6, max_children_per_line=4)
        for title, enabled, level in (("Solid", False, 0), ("Subtle", True, 10),
                                      ("Balanced", True, 25), ("Clear", True, 50)):
            button = Gtk.Button(label=title)
            button.connect("clicked", self.set_files_preset, enabled, level)
            presets.append(button)
        body.append(presets)
        files_actions = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=8,
                                    row_spacing=8, max_children_per_line=2)
        self.files_restart = Gtk.Button(label="Restart Files…")
        self.files_restart.connect("clicked", self.confirm_files_restart)
        files_actions.append(self.files_restart)
        reset_files = Gtk.Button(label="Reset Files appearance")
        reset_files.connect("clicked", lambda *_: self.confirm_reset("Files", {
            "files": {"enabled": False, "transparency": 25}}))
        files_actions.append(reset_files)
        body.append(files_actions)
        self.files_saved = files_value.copy()
        self.files_switch_handler = self.files_switch.connect("notify::active", self.on_files_appearance_changed)
