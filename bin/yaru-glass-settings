        for mark in (0, 25, 50):
            self.app_scale.add_mark(mark, Gtk.PositionType.BOTTOM, f"{mark}%")
        self.app_percent = Gtk.Label(label=f"{app_appearance['transparency']}%", width_chars=4)
        app_row.append(self.app_scale)
        app_row.append(self.app_percent)
        app_group.add(app_row)
        body.append(app_group)
        self.app_status = Gtk.Label(label="Saved appearance applies immediately to this app only.",
