            app_error = str(exc)
        self.app_appearance = app_appearance
        self.invalid_sections = {name for name, failure in (("shell", error), ("app", app_error)) if failure}
        self.app_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), self.app_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.style_manager = Adw.StyleManager.get_default()
        self.dark_changed_id = self.style_manager.connect("notify::dark", self.update_app_style)

