        header.pack_start(self.diagnostics_button)
        self.updates_button = Gtk.Button(label="Updates", tooltip_text="Check and install Yaru Glass updates")
        self.updates_button.connect("clicked", self.open_updates)
        header.pack_end(self.updates_button)
        content.append(header)
        self.pages = Gtk.Stack(vexpand=True)
        self.page_bodies = {}
        for name, title in (("shell", "Shell"), ("applications", "Applications"),
                            ("wallpapers", "Wallpapers")):
            page_body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                                margin_top=20, margin_bottom=24, margin_start=24, margin_end=24)
