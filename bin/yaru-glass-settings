#!/usr/bin/python3
"""Native transparency control for the installed Yaru Glass theme pair."""
import sys
import json
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Gtk

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src/yaru_glass"))
from theme_settings import (
    DEFAULT_TRANSPARENCY, load_settings, load_app_appearance, validate_settings,
    app_opacity, preset_values, preset_name, gtk_material,
)
import wallpapers
import files_appearance
import diagnostics


SECTION_LABELS = {"shell": "Shell", "app": "Settings app", "files": "Files"}
SETTING_LABELS = {
    ("shell", "transparency"): "Transparency level",
    ("shell", "glass_mode"): "Glass style",
    ("shell", "solid"): "Solid backgrounds",
    ("shell", "readability_boost"): "Readability boost",
    ("shell", "background_blur"): "Dynamic background blur",
    ("app", "enabled"): "Transparency",
    ("app", "transparency"): "Transparency level",
    ("files", "enabled"): "Transparency",
    ("files", "transparency"): "Transparency level",
}


def format_confirmation_changes(snapshot, patch, invalid_sections=()):
    lines = []
    for section, fields in patch.items():
        lines.append(SECTION_LABELS.get(section, section.replace("_", " ").title()))
        current = snapshot.get(section, {})
        for key, value in fields.items():
            label = SETTING_LABELS.get((section, key), key.replace("_", " ").title())
            before = "Invalid or unavailable" if section in invalid_sections else current.get(key, "Not set")
            if key == "transparency":
                before = f"{before}%" if type(before) is int else str(before)
                after = f"{value}%"
            elif key == "glass_mode":
                before, after = str(before).title(), str(value).title()
            elif key == "enabled":
                if type(before) is bool:
                    before = "Enabled" if before else "Disabled"
                after = "Enabled" if value else "Disabled"
            elif isinstance(value, bool):
                if type(before) is bool:
                    before = "On" if before else "Off"
                after = "On" if value else "Off"
            else:
                before, after = str(before), str(value)
            lines.append(f"  {label}: {before} → {after}")
    return "\n".join(lines)


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="Yaru Glass Settings")
        self.set_default_size(540, 650)
        self.add_css_class("yaru-settings-window")
        self.timeout_id = 0
        self.process = None
        self.requested = None
        self.closing = False
        self.syncing = False
        self.failed_patch = None
        self.files_live_confirmed = False
        self.files_restart_process = None
        self.files_restart_watch = 0
        self.files_restart_timeout = 0
        self.update_installing = False
        self.update_installed = False
        self.loaded_version = (ROOT / "VERSION").read_text()
        error = None
        try:
            settings = load_settings()
        except (OSError, ValueError) as exc:
