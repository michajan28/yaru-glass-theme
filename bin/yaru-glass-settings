        files_row = Gtk.Box(spacing=12, margin_top=8)
        self.files_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 50, 1)
        self.files_scale.set_hexpand(True)
        self.files_scale.set_draw_value(False)
        self.files_scale.set_round_digits(0)
        self.files_scale.set_value(files_value["transparency"])
        self.files_scale.set_sensitive(files_value["enabled"])
        self.files_scale.update_property([Gtk.AccessibleProperty.LABEL], ["Files transparency"])
        for mark in (0, 25, 50):
            self.files_scale.add_mark(mark, Gtk.PositionType.BOTTOM, f"{mark}%")
        self.files_percent = Gtk.Label(label=f"{files_value['transparency']}%", width_chars=4)
        files_row.append(self.files_scale)
        files_row.append(self.files_percent)
        files_group.add(files_row)
        body.append(files_group)
        self.files_status = Gtk.Label(
            label="Saved configuration loaded. Restart Files if it has not loaded these settings.",
            xalign=0, wrap=True)
        body.append(self.files_status)
        self.files_retry = Gtk.Button(label="Retry Files appearance", halign=Gtk.Align.START)
        self.files_retry.set_visible(False)
        self.files_retry.connect("clicked", lambda *_: self.retry_failed() if self.failed_patch
