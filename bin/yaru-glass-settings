        self.app_switch.set_active(app_appearance["enabled"])
        app_group.add(self.app_switch)
        app_row = Gtk.Box(spacing=12, margin_top=8)
        self.app_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 50, 1)
        self.app_scale.set_hexpand(True)
        self.app_scale.set_draw_value(False)
        self.app_scale.set_round_digits(0)
